<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. บล็อกการเข้าถึงไฟล์ระบบที่สำคัญโดยตรง (เอาคำว่า storage ออกแล้ว)
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|artisan)(/|$) - [F,L]

    # 2. บังคับให้การเรียกเว็บทั้งหมด วิ่งเข้าไปที่โฟลเดอร์ /public ทันที
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>